[Unit]
Description=Synchronize CertPouch inventory, NSD zones and certificates
Wants=network-online.target
After=network-online.target nsd.service

[Service]
Type=exec
ExecStart=/usr/local/bin/certpouch pipeline --watch --config /etc/certpouch/server.yaml
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The include is atomically replaced in its parent directory.
ReadWritePaths=/etc/nsd /var/lib/certpouch

[Install]
WantedBy=multi-user.target
