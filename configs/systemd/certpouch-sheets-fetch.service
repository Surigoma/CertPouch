[Unit]
Description=Refresh CertPouch DNS inventory from Google Sheets
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=certpouch-sheets
Group=certpouch
ExecStart=/usr/local/bin/certpouch dns fetch --config /etc/certpouch-sheets/fetch.yaml
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dns-inventory
